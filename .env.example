# Server-only public application URL used for Supabase Auth e-mail redirects.
APP_URL=https://saovia-test2.vercel.app
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Orange SMS (variables serveur uniquement, jamais préfixées par VITE_)
ORANGE_SMS_API_URL=
# Utilisez soit un jeton statique, soit les trois variables OAuth ci-dessous.
ORANGE_SMS_API_TOKEN=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_TOKEN_URL=
ORANGE_SMS_SENDER=
ORANGE_SMS_TIMEOUT_MS=10000
ORANGE_SMS_MAX_ATTEMPTS=3
